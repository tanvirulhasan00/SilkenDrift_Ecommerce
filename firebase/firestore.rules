rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // AUTHENTICATION & ROLE-BASED ACCESS CONTROL (RBAC) HELPERS
    // ========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'admin' ||
        request.auth.token.email == 'admin@silkendrift.com'
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        getUserRole() in ['admin', 'manager'] ||
        isAdmin() ||
        request.auth.token.email in ['admin@silkendrift.com', 'manager@silkendrift.com']
      );
    }

    // ========================================================================
    // PUBLIC CATALOG (Read: Public | Write: Role-gated to Admin/Manager)
    // ========================================================================

    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /productVariants/{variantId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /subcategories/{subId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /pickupPoints/{pointId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ========================================================================
    // USER PROFILES & ADDRESS PRIVACY (Scoped to owner or staff)
    // ========================================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isStaff() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
    }

    match /addresses/{addressId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // ========================================================================
    // ORDERS & FULFILLMENT
    // ========================================================================

    match /orders/{orderId} {
      // Public read by order ID/tracking for public track page, or scoped to customer
      allow read: if true;
      // Creation allowed for guest and registered checkout
      allow create: if request.resource.data.totalBDT > 0 && request.resource.data.items.size() > 0;
      // Mutations (status updates, courier tracking) restricted to authenticated staff
      allow update: if isStaff();
      // Deletions prohibited to preserve audit trail
      allow delete: if false;
    }

    // ========================================================================
    // INVENTORY, SOURCING & WAREHOUSE (Role-gated to Staff)
    // ========================================================================

    match /inventory/{itemId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /inventoryMovements/{movId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false; // Immutable ledger
    }

    match /suppliers/{supplierId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /sourcingRecords/{recordId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // ========================================================================
    // REVIEWS & PRODUCT QUESTIONS
    // ========================================================================

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isStaff();
    }

    match /productQuestions/{questionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }

    // ========================================================================
    // SUPPORT TICKETS & INQUIRIES
    // ========================================================================

    match /supportTickets/{ticketId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if true; // Public contact form
      allow read, update, delete: if isStaff();
    }

    // ========================================================================
    // BUSINESS SETTINGS & AUDIT LOGS (Super-Admin Only)
    // ========================================================================

    match /settings/{docId} {
      allow read: if true; // Public store metadata
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public catalog (Products, Categories, Brands, Banners, Zones)
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Allows Admin dashboard & data seeding on Spark tier
    }
    
    match /productVariants/{variantId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /subcategories/{subId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /brands/{brandId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /pickupPoints/{pointId} {
      allow read: if true;
      allow write: if true;
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    // Users and Customers
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Addresses
    match /addresses/{addressId} {
      allow read, write: if true;
    }

    // Orders (Direct client creation on Free Spark Plan)
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true; // Enables guest & registered checkout without Cloud Functions
      allow update: if true; // Enables status updates & delivery tracking
      allow delete: if false; // Audit preservation
    }

    // Inventory & Sourcing
    match /inventory/{itemId} {
      allow read, write: if true;
    }

    match /inventoryMovements/{movId} {
      allow read, write: if true;
    }

    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    match /sourcingRecords/{recordId} {
      allow read, write: if true;
    }

    // Reviews & Product Questions
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /productQuestions/{questionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Support Tickets & Contact Inquiries
    match /supportTickets/{ticketId} {
      allow read, write: if true;
    }

    match /contactMessages/{messageId} {
      allow read, write: if true;
    }

    // Settings
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
  }
}

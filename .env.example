# ==================================================
# SilkenDrift Bangladesh eCommerce - Environment Variables Template
# ==================================================

# --- Firebase Client SDK (Storefront & Dashboard Web App) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# --- Firebase Tier Strategy ---
# spark: Uses direct browser Firestore & Auth SDK with free tier limits (50k reads/day, 20k writes/day)
# blaze: Allows server-side Cloud Functions execution
VITE_FIREBASE_PLAN=spark

# --- Application Configuration ---
VITE_APP_NAME="SilkenDrift"
VITE_APP_URL=http://localhost:3000
VITE_DEFAULT_LANGUAGE=bn

# --- Server-Side Only Credentials (For optional Cloud Functions on Blaze upgrade) ---
BKASH_APP_KEY=your_bkash_app_key_here
BKASH_APP_SECRET=your_bkash_app_secret_here
BKASH_USERNAME=your_bkash_merchant_username
BKASH_PASSWORD=your_bkash_merchant_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

SSL_STORE_ID=your_sslcommerz_store_id
SSL_STORE_PASSWORD=your_sslcommerz_store_password
SSL_IS_SANDBOX=true

PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key
